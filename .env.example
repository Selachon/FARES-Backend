# ============================================
# FARES Backend - Environment Variables
# ============================================
# IMPORTANTE: Copia este archivo a .env y configura los valores reales
# NO SUBIR .env a git (ya está en .gitignore)

# ============================================
# ENTORNO
# ============================================
LOCAL_DEV=0
NODE_ENV=production

# ============================================
# MONGODB
# ============================================
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_LOCAL_DB=fares_local

# ============================================
# SERVIDOR
# ============================================
PORT=3001
HOST=0.0.0.0

# ============================================
# SEGURIDAD - JWT (REQUERIDO)
# ============================================
# Secreto para firmar tokens JWT - DEBE ser una cadena aleatoria larga y segura
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_LARGO_Y_SEGURO

# ============================================
# SEGURIDAD - APP MÓVIL (REQUERIDO)
# ============================================
# Clave API para autenticar la app móvil
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_API_KEY=CAMBIAR_POR_CLAVE_API_ALEATORIA

# ============================================
# GOOGLE DRIVE (REQUERIDO)
# ============================================
GOOGLE_OAUTH_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=tu-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=tu-refresh-token

# Carpeta destino en Google Drive
DRIVE_PARENT_FOLDER_ID=id-de-carpeta-en-drive

# Carpetas específicas (opcional)
# DRIVE_FOLDER_INF=
# DRIVE_FOLDER_FOR=
# DRIVE_FOLDER_CERT=

# ============================================
# EMAIL - BREVO
# ============================================
BREVO_API_KEY=tu-api-key
BREVO_HOST=smtp-relay.brevo.com
BREVO_PORT=587
BREVO_LOGIN=tu-login@smtp-brevo.com

# ============================================
# EMAIL - SMTP DIRECTO (OPCIONAL)
# ============================================
EMAIL_HOST=mail.tudominio.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=admin@tudominio.com
EMAIL_PASS=tu-password

# ============================================
# FRONTEND URL (PARA DESARROLLO)
# ============================================
VITE_API_URL=http://localhost:4000/api
